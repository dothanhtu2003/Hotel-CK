generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["hotel"]
}

enum Role {
  GUEST
  RECEPTIONIST
  HOUSEKEEPING
  ADMIN

  @@schema("hotel")
}

enum AccountStatus {
  ACTIVE
  DISABLED

  @@schema("hotel")
}

enum OperationalStatus {
  ACTIVE
  OUT_OF_SERVICE

  @@schema("hotel")
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING

  @@schema("hotel")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED

  @@schema("hotel")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@schema("hotel")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@schema("hotel")
}

enum InvoiceStatus {
  ISSUED
  PAID

  @@schema("hotel")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER

  @@schema("hotel")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED

  @@schema("hotel")
}

model User {
  id            String             @id @default(uuid()) @db.Uuid
  fullName      String             @map("full_name") @db.VarChar(120)
  email         String?            @unique @db.VarChar(254)
  passwordHash  String             @map("password_hash") @db.VarChar(255)
  phone         String?            @db.VarChar(24)
  role          Role               @default(GUEST)
  status        AccountStatus      @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings      Booking[] @relation("BookingOwner")
  createdBookings Booking[] @relation("BookingCreator")
  assignedTasks HousekeepingTask[]
  collectedServiceOrders ServiceOrder[] @relation("ServiceOrderCollector")
  refundedServiceOrders ServiceOrder[] @relation("ServiceOrderRefunder")
  manuallyCompletedTasks HousekeepingTask[] @relation("ManualTaskCompleter")
  roomStatusChanges RoomStatusChange[]

  @@map("users")
  @@schema("hotel")
}

model RoomType {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(80)
  description  String?
  nightlyPrice Decimal  @map("nightly_price") @db.Decimal(14, 2)
  maxGuests    Int      @map("max_guests")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rooms        Room[]

  @@map("room_types")
  @@schema("hotel")
}

model Room {
  id                 String             @id @default(uuid()) @db.Uuid
  roomNumber         String             @unique @map("room_number") @db.VarChar(12)
  roomTypeId         String             @map("room_type_id") @db.Uuid
  floor              Int
  operationalStatus  OperationalStatus  @default(ACTIVE) @map("operational_status")
  housekeepingStatus HousekeepingStatus @default(CLEAN) @map("housekeeping_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  roomType           RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  images             RoomImage[]
  bookings           Booking[]
  tasks              HousekeepingTask[]
  statusChanges      RoomStatusChange[]

  @@index([roomTypeId, operationalStatus])
  @@map("rooms")
  @@schema("hotel")
}

model RoomImage {
  id           String  @id @default(uuid()) @db.Uuid
  roomId       String  @map("room_id") @db.Uuid
  secureUrl    String  @map("secure_url") @db.VarChar(2048)
  publicId     String  @unique @map("public_id") @db.VarChar(255)
  isPrimary    Boolean @default(false) @map("is_primary")
  displayOrder Int     @default(0) @map("display_order")
  room         Room    @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([roomId, displayOrder])
  @@map("room_images")
  @@schema("hotel")
}

model Booking {
  checkoutRequestedAt DateTime? @map("checkout_requested_at") @db.Timestamptz(3)
  createdById     String?        @map("created_by_id") @db.Uuid
  id              String         @id @default(uuid()) @db.Uuid
  reference       String         @unique @default(uuid()) @db.VarChar(40)
  userId          String         @map("user_id") @db.Uuid
  roomId          String         @map("room_id") @db.Uuid
  checkInDate     DateTime       @map("check_in_date") @db.Date
  checkOutDate    DateTime       @map("check_out_date") @db.Date
  guestCount      Int            @map("guest_count")
  status          BookingStatus  @default(PENDING)
  nightlyPrice    Decimal        @default(0) @map("nightly_price") @db.Decimal(14, 2)
  totalRoomAmount Decimal        @default(0) @map("total_room_amount") @db.Decimal(14, 2)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       User?          @relation("BookingCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user            User           @relation("BookingOwner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  room            Room           @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serviceOrders   ServiceOrder[]
  invoice         Invoice?

  @@index([createdById], map: "bookings_created_by_idx")
  @@index([userId, createdAt])
  @@index([roomId, checkInDate, checkOutDate])
  @@index([status, checkInDate])
  @@map("bookings")
  @@schema("hotel")
}

model Service {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique @db.VarChar(120)
  description  String?
  currentPrice Decimal            @map("current_price") @db.Decimal(14, 2)
  isActive     Boolean            @default(true) @map("is_active")
  items        ServiceOrderItem[]

  @@map("services")
  @@schema("hotel")
}

model ServiceOrder {
  id          String             @id @default(uuid()) @db.Uuid
  bookingId   String             @map("booking_id") @db.Uuid
  status      OrderStatus        @default(PENDING)
  totalAmount Decimal            @default(0) @map("total_amount") @db.Decimal(14, 2)
  orderedAt   DateTime           @default(now()) @map("ordered_at") @db.Timestamptz(3)
  paymentMethod PaymentMethod?    @map("payment_method")
  paidAt      DateTime?           @map("paid_at") @db.Timestamptz(3)
  receivedBy  String?             @map("received_by") @db.Uuid
  refundedAt  DateTime?           @map("refunded_at") @db.Timestamptz(3)
  refundedBy  String?             @map("refunded_by") @db.Uuid
  collector   User?              @relation("ServiceOrderCollector", fields: [receivedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refunder    User?              @relation("ServiceOrderRefunder", fields: [refundedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  booking     Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items       ServiceOrderItem[]

  @@index([bookingId, status])
  @@map("service_orders")
  @@schema("hotel")
}

model ServiceOrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceId      String       @map("service_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal      @default(0) @map("unit_price") @db.Decimal(14, 2)
  subtotal       Decimal      @default(0) @db.Decimal(14, 2)
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([serviceOrderId, serviceId])
  @@index([serviceId])
  @@map("service_order_items")
  @@schema("hotel")
}

model HousekeepingTask {
  id              String     @id @default(uuid()) @db.Uuid
  roomId          String     @map("room_id") @db.Uuid
  assignedStaffId String?    @map("assigned_staff_id") @db.Uuid
  status          TaskStatus @default(TODO)
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(3)
  manualCompletedBy String? @map("manual_completed_by") @db.Uuid
  manualCompleter User? @relation("ManualTaskCompleter", fields: [manualCompletedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  room            Room       @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedStaff   User?      @relation(fields: [assignedStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([assignedStaffId, status])
  @@index([roomId, createdAt])
  @@map("housekeeping_tasks")
  @@schema("hotel")
}

model RoomStatusChange {
  id String @id @default(uuid()) @db.Uuid
  roomId String @map("room_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  condition String @db.VarChar(20)
  previousOperationalStatus OperationalStatus @map("previous_operational_status")
  previousHousekeepingStatus HousekeepingStatus @map("previous_housekeeping_status")
  completedTaskIds String[] @map("completed_task_ids") @db.Uuid
  note String? @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([roomId, createdAt])
  @@map("room_status_changes")
  @@schema("hotel")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String        @unique @map("booking_id") @db.Uuid
  roomAmount    Decimal       @default(0) @map("room_amount") @db.Decimal(14, 2)
  serviceAmount Decimal       @default(0) @map("service_amount") @db.Decimal(14, 2)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payments      Payment[]

  @@map("invoices")
  @@schema("hotel")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  invoiceId String        @map("invoice_id") @db.Uuid
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?     @map("paid_at") @db.Timestamptz(3)
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([invoiceId, status])
  @@map("payments")
  @@schema("hotel")
}
