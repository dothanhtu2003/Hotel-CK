{
  "name": "hotel-ck-database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 start",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 stop",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:test-data": "tsx scripts/seed-test-data.ts",
    "db:verify": "tsx scripts/verify.ts",
    "test:database": "tsx --test --test-concurrency=1 tests/database/*.test.ts",
    "typecheck": "tsc --noEmit",
    "auth:setup": "tsx scripts/init-auth-env.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/src/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/src/main.js\"",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint src tests scripts prisma/seed.ts prisma.config.ts",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:backend",
    "test:backend": "npm run build:test && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --runInBand",
    "test:unit": "npm run build:test && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --runInBand --selectProjects unit",
    "test:e2e": "npm run build:test && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --runInBand --selectProjects integration"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.3",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsc-watch": "7.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
