# Copy locally; never commit populated URLs. Percent-encode URL passwords.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=hotel&sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres?schema=hotel&sslmode=verify-full"
# Only a dedicated disposable database may be used by integration tests.
TEST_DATABASE_URL=""
ALLOW_DEMO_SEED="false"
DEMO_PASSWORD=""

# Backend defaults; existing .env remains valid without these optional values.
NODE_ENV="development"
HOST="127.0.0.1"
# Production (Phase 10): NODE_ENV=production, HOST=0.0.0.0, platform PORT,
# DATABASE_URL with sslmode=verify-full and a trusted certificate; explicit CORS origin.
PORT="3000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Generate a random secret locally; no default credential is provided.
JWT_SECRET=""
JWT_ACCESS_TTL_SECONDS="900"
# Staff sessions last a full workday (RECEPTIONIST, ADMIN, HOUSEKEEPING).
JWT_STAFF_TTL_SECONDS="86400"
AUTH_RATE_LIMIT="5"
AUTH_RATE_TTL_MS="60000"
